<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    tools:context=".ui.user.bookings.BookingsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bookings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBookService"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="28dp"
            android:paddingEnd="12dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_bookings_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bookings_title"
                        android:textColor="#1A202C"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_bookings_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/bookings_subtitle"
                        android:textColor="#5C6C80"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        tools:text="Manage upcoming visits and service history." />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_filter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/bookings_filter_action"
                    android:textAllCaps="false"
                    android:textColor="#1A202C"
                    android:textSize="13sp"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_filter"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#1A202C"
                    app:strokeColor="#D7DEE8"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_next_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bookings_next"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/text_next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/bookings_next_label"
                        android:textAllCaps="true"
                        android:textColor="#BFD7FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_status"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:text="@string/bookings_status_confirmed"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@android:color/white"
                        app:chipEndPadding="12dp"
                        app:chipStartPadding="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:rippleColor="@android:color/transparent"
                        tools:text="Confirmed" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_service_icon"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#1E2A78"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_next_label"
                        app:strokeColor="#3A4BAF"
                        app:strokeWidth="1dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/image_next_service"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/bookings_schedule_cd"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_booking"
                            app:shapeAppearanceOverlay="@style/SkillLink.Shape.Circle"
                            app:strokeColor="@android:color/transparent"
                            app:strokeWidth="0dp"
                            tools:ignore="ContentDescription" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/text_next_service"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/card_service_icon"
                        app:layout_constraintTop_toTopOf="@id/card_service_icon"
                        tools:text="AC Maintenance" />

                    <TextView
                        android:id="@+id/text_next_provider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#D9E4FF"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/text_next_service"
                        app:layout_constraintStart_toStartOf="@id/text_next_service"
                        app:layout_constraintTop_toBottomOf="@id/text_next_service"
                        tools:text="SkillFix Professionals" />

                    <TextView
                        android:id="@+id/text_next_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_home_chip"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/text_next_service"
                        app:layout_constraintTop_toBottomOf="@id/text_next_provider"
                        tools:text="LKR 8,500" />

                    <TextView
                        android:id="@+id/text_next_schedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_home_chip"
                        android:backgroundTint="#26FFFFFF"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        app:layout_constraintBaseline_toBaselineOf="@id/text_next_price"
                        app:layout_constraintStart_toEndOf="@id/text_next_price"
                        tools:text="Tomorrow · 9:30 AM" />

                    <TextView
                        android:id="@+id/text_next_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_home_chip"
                        android:backgroundTint="#1A1F4D"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="#D9E4FF"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/text_next_service"
                        app:layout_constraintStart_toStartOf="@id/text_next_service"
                        app:layout_constraintTop_toBottomOf="@id/text_next_price"
                        tools:text="15/4 Downtown Avenue, Colombo" />

                    <TextView
                        android:id="@+id/text_next_payment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_home_chip"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/text_next_service"
                        app:layout_constraintTop_toBottomOf="@id/text_next_location"
                        tools:text="Cash on completion" />

                    <LinearLayout
                        android:id="@+id/row_next_actions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_next_payment">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_next_chat"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/bookings_action_chat"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                app:icon="@drawable/ic_chat"
                                app:iconGravity="textStart"
                                app:iconPadding="10dp"
                                app:iconTint="#FFFFFF"
                                app:strokeColor="#80FFFFFF"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_next_details"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/bookings_details_action"
                                android:textAllCaps="false"
                                android:textColor="#1A202C"
                                android:textSize="14sp"
                                app:backgroundTint="@android:color/white"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_arrow_right"
                                app:iconGravity="textStart"
                                app:iconPadding="10dp"
                                app:iconTint="#1A202C"
                                app:rippleColor="@android:color/transparent"
                                app:strokeWidth="0dp" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_next_cancel"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/bookings_action_cancel"
                            android:textAllCaps="false"
                            android:textColor="#FF6B6B"
                            android:textSize="14sp"
                            app:backgroundTint="@android:color/transparent"
                            app:icon="@drawable/ic_close"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="#FF6B6B"
                            app:strokeColor="#B3FFFFFF"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_upcoming_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/bookings_next_helper"
                android:textColor="#4A5568"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                tools:text="Stay ready — we will remind you an hour before the visit." />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:minHeight="40dp"
                android:paddingBottom="4dp"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_active"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/bookings_filter_active" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_scheduled"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bookings_filter_scheduled" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_history"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bookings_filter_history" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_bookings_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_bookings_list_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bookings_list_title"
                            android:textColor="#1A202C"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Upcoming visits" />

                        <TextView
                            android:id="@+id/text_bookings_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_home_chip"
                            android:backgroundTint="#EEF2FF"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="#3F51B5"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="3" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_bookings_list_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/bookings_list_subtitle"
                        android:textColor="#60759A"
                        android:textSize="12sp"
                        tools:text="Track progress or revisit completed services." />

                    <TextView
                        android:id="@+id/text_bookings_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/bookings_list_empty"
                        android:textColor="#60759A"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="All caught up! No other bookings to display."
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewBookings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingBottom="4dp"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_booking" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBookService"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:text="@string/bookings_cta_primary"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:backgroundTint="@color/primary_color"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_booking"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#EEF2F8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/bookings_empty_cd"
                    android:src="@drawable/ic_booking" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/bookings_empty_title"
                    android:textColor="#1A202C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/bookings_empty_body"
                    android:textColor="#5C6C80"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_empty_book"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/bookings_cta_primary"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/primary_color"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_booking"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@android:color/white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>