<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="0dp"
    tools:context=".ui.worker.jobs.JobsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJobsHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_worker_jobs_header"
                android:padding="24dp">

                <TextView
                    android:id="@+id/textHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="@string/worker_jobs_title"
                    android:textColor="@color/worker_home_hero_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/imageHero"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Jobs board" />

                <TextView
                    android:id="@+id/textHeroSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.92"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/worker_jobs_subtitle"
                    android:textColor="@color/worker_home_hero_muted"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/imageHero"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textHeroTitle"
                    tools:text="Stay on top of new opportunities and respond faster." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonScrollToActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/worker_jobs_cta"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:backgroundTint="@color/worker_home_cta"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textEnd"
                    app:iconPadding="10dp"
                    app:iconTint="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textHeroSubtitle"
                    app:rippleColor="@color/worker_home_cta_ripple" />

                <ImageView
                    android:id="@+id/imageHero"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@string/worker_jobs_hero_image_cd"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_worker_hero"
                    android:translationY="6dp"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@android:color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/worker_home_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/textTabsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/worker_jobs_filter_title"
                    android:textColor="@color/worker_home_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Status" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    app:tabIndicatorColor="@color/worker_home_cta"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorGravity="center"
                    app:tabIndicatorHeight="3dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/worker_home_cta_ripple"
                    app:tabSelectedTextColor="@color/worker_home_cta"
                    app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Button"
                    app:tabTextColor="@color/worker_home_text_secondary">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_jobs_tab_active" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_jobs_tab_completed" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_jobs_tab_cancelled" />
                </com.google.android.material.tabs.TabLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewJobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            android:background="@drawable/bg_worker_jobs_empty">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_worker"
                android:tint="@color/worker_home_cta" />

            <TextView
                android:id="@+id/textEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/worker_jobs_empty_title"
                android:textColor="@color/worker_home_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/worker_jobs_empty_body"
                android:textAlignment="center"
                android:textColor="@color/worker_home_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEmptyAction"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/worker_jobs_empty_cta"
                android:textColor="@color/worker_home_cta"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/worker_home_cta"
                app:strokeWidth="1dp"
                tools:text="Refresh" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>