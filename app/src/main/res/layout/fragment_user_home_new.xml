<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_surface"
    tools:context=".ui.user.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:paddingTop="24dp">

            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_home_icon_circle"
                    android:contentDescription="@string/app_name"
                    android:padding="12dp"
                    android:src="@drawable/ic_skill_link_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_brand_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_brand_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_brand_subtitle"
                        android:textColor="#60759A"
                        android:textSize="12sp" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/button_notifications"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_home_icon_circle"
                        android:contentDescription="@string/home_notifications_cd"
                        android:padding="12dp"
                        android:src="@drawable/ic_notification" />

                    <View
                        android:id="@+id/notification_badge"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="end|top"
                        android:background="@drawable/bg_home_icon_circle"
                        android:backgroundTint="@color/secondary_color"
                        android:translationX="4dp"
                        android:translationY="-2dp" />

                </FrameLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_hero"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/text_hero_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_tag"
                        android:text="@string/home_hero_badge"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:letterSpacing="0.02" />

                    <ImageView
                        android:id="@+id/hero_image"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/text_greeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/hero_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_hero_badge"
                        tools:text="Good day, Maya" />

                    <TextView
                        android:id="@+id/text_tagline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/home_greeting_tagline"
                        android:textColor="#E0E7FF"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/hero_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_greeting"
                        tools:text="Let’s match you with the right professional today." />

                    <LinearLayout
                        android:id="@+id/hero_location_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toStartOf="@id/hero_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_tagline">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/home_location_prefix"
                            android:src="@drawable/ic_location"
                            android:tint="#E0E7FF" />

                        <TextView
                            android:id="@+id/text_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/home_location_placeholder"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Colombo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_update_location"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:text="@string/home_location_button"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            app:backgroundTint="#33FFFFFF"
                            app:iconPadding="0dp"
                            app:iconSize="0dp"
                            app:strokeColor="#4DFFFFFF"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_new_booking"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/home_action_book"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:backgroundTint="@color/secondary_color"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_booking"
                        app:iconPadding="12dp"
                        app:iconTint="@android:color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/hero_location_row" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/home_search_cd"
                        android:src="@drawable/ic_search"
                         />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_layout_search_services"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="@string/home_search_hint"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColorHint="#60759A"
                        app:boxBackgroundMode="none"
                        app:endIconMode="clear_text"
                        app:endIconTint="#90A3BF"
                        app:hintTextColor="#60759A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_search_services"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:textColor="#1A202C"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:id="@+id/button_voice_search"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/home_voice_search_cd"
                        android:padding="6dp"
                        android:src="@drawable/ic_mic"
                        android:tint="#60759A" />

                    <ImageView
                        android:id="@+id/button_filter_search"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/home_filter_search_cd"
                        android:padding="6dp"
                        android:src="@drawable/ic_filter"
                        android:tint="@color/primary_color" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/metrics_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_metric"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/metric_services_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_metric_services_label"
                        android:textColor="#60759A"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_metric"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/metric_professionals_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="86" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_metric_professionals_label"
                        android:textColor="#60759A"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_metric"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/metric_rating_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="4.8★" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_metric_rating_label"
                        android:textColor="#60759A"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/text_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#60759A"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Showing 3 services for &#8220;pl&#8221;" />

            <LinearLayout
                android:id="@+id/services_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/services_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_section_services"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_services_all"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/home_view_all"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_color"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/services_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_section_services_subtitle"
                    android:textColor="#60759A"
                    android:textSize="12sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categories_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_animation_fall_down"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingEnd="0dp"
                android:paddingStart="0dp"
                tools:listitem="@layout/item_service_category" />

            <LinearLayout
                android:id="@+id/worker_services_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/worker_services_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_section_worker_services"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_worker_services_all"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/home_view_all"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_color"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/worker_services_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_section_worker_services_subtitle"
                    android:textColor="#60759A"
                    android:textSize="12sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/worker_services_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_home_worker_service"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/worker_services_preview_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#60759A"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Showing top 4 of 12 services"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/worker_services_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_service_manage"
                    android:tint="#C2CCDE" />

                <TextView
                    android:id="@+id/worker_services_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_worker_services_empty_title"
                    android:textColor="#1A202C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/worker_services_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/home_worker_services_empty_message"
                    android:textColor="#60759A"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:paddingHorizontal="32dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/emergency_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/emergency_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_section_emergency"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergency_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_emergency"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/emergency_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_tag"
                        android:text="@string/home_emergency_badge"
                        android:textColor="#6D6767"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/emergency_header_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/emergency_badge">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_home_icon_circle"
                            android:contentDescription="@string/home_emergency_headline"
                            android:padding="8dp"
                            android:src="@drawable/ic_support"
                            android:tint="#F97373" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/emergency_headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_emergency_headline"
                                android:textColor="#BA3333"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Need urgent help?" />

                            <TextView
                                android:id="@+id/emergency_body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#565252"
                                android:textSize="13sp"
                                android:text="@string/home_emergency_body" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/emergency_highlights"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:chipSpacingHorizontal="10dp"
                        app:chipSpacingVertical="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/emergency_header_row">

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_emergency_chip_available"
                            android:textAllCaps="false"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/white"
                            app:chipIcon="@drawable/ic_spark"
                            app:chipIconTint="@color/secondary_color"
                            app:ensureMinTouchTargetSize="false" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_emergency_chip_verified"
                            android:textAllCaps="false"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/white"
                            app:chipIcon="@drawable/ic_verified"
                            app:chipIconTint="@color/secondary_color"
                            app:ensureMinTouchTargetSize="false" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_emergency_chip_response"
                            android:textAllCaps="false"
                            android:textColor="#1A202C"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/white"
                            app:chipIcon="@drawable/ic_schedule"
                            app:chipIconTint="@color/secondary_color"
                            app:ensureMinTouchTargetSize="false" />

                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/emergency_highlights">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_emergency_request"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:text="@string/home_emergency_cta_request"
                            android:textAllCaps="false"
                            android:textColor="#1A202C"
                            android:textSize="13sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_spark"
                            app:iconPadding="10dp"
                            app:iconTint="#1A202C" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_emergency_call"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/home_emergency_cta_call"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            app:backgroundTint="@color/secondary_color"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_call"
                            app:iconPadding="10dp"
                            app:iconTint="#FFFFFF" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/map_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/map_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_section_map"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_map"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/home_map_preview_cta"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_color"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/map_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:id="@+id/map_preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <com.google.android.gms.maps.MapView
                        android:id="@+id/map_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        tools:ignore="MissingSuperCall" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#330C1330" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_booking_bottom_card"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="24dp">

                        <TextView
                            android:id="@+id/text_map_preview_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_map_preview_title"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_map_preview_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_map_preview_body"
                            android:textColor="#E4ECFF"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_map_cta"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/home_map_preview_cta"
                            android:textAllCaps="false"
                            android:textColor="@color/primary_color"
                            android:textSize="13sp"
                            app:backgroundTint="@android:color/white"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_location"
                            app:iconPadding="10dp"
                            app:iconTint="@color/primary_color" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/map_preview_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        app:indicatorSize="32dp" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>