<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeColor="#F0F3FA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_service"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="@string/bookings_service_image_cd"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_service_manage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/SkillLink.Shape.Circle"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/text_service_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#182033"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/chip_status"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@id/image_service"
                app:layout_constraintTop_toTopOf="@id/image_service"
                app:layout_goneMarginEnd="0dp"
                android:layout_marginStart="14dp"
                tools:text="AC Maintenance" />

            <TextView
                android:id="@+id/text_service_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#60759A"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/image_service"
                app:layout_constraintEnd_toStartOf="@+id/chip_status"
                app:layout_constraintStart_toStartOf="@id/text_service_name"
                app:layout_constraintTop_toBottomOf="@id/text_service_name"
                tools:text="SkillFix Professionals" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1A202C"
                android:textSize="12sp"
                app:chipBackgroundColor="@android:color/white"
                app:chipEndPadding="10dp"
                app:chipIcon="@drawable/ic_check_circle"
                app:chipIconTint="#1A202C"
                app:chipIconVisible="true"
                app:chipMinHeight="32dp"
                app:chipStartPadding="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Confirmed" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/text_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#344055"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            tools:text="Replace faulty electrical outlet in living room" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EEF2F8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/bookings_schedule_cd"
                android:src="@drawable/ic_time" />

            <TextView
                android:id="@+id/text_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#3A4556"
                android:textSize="13sp"
                tools:text="Tomorrow · 9:30 AM" />

            <TextView
                android:id="@+id/text_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_chip"
                android:backgroundTint="#EEF3FF"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="#3949AB"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="LKR 8,500" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/bookings_location_cd"
                android:src="@drawable/ic_location" />

            <TextView
                android:id="@+id/text_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#3A4556"
                android:textSize="13sp"
                tools:text="15/4 Downtown Avenue, Colombo" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/bookings_payment_method_cd"
                android:src="@drawable/ic_payment" />

            <TextView
                android:id="@+id/text_payment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#3A4556"
                android:textSize="13sp"
                tools:text="Cash on completion" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_view_details"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/bookings_details_action"
                    android:textAllCaps="false"
                    android:textColor="#1A202C"
                    android:textSize="14sp"
                    app:backgroundTint="#F4F7FC"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="#1A202C"
                    app:rippleColor="@android:color/transparent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_message"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/bookings_action_chat"
                    android:textAllCaps="false"
                    android:textColor="#1A202C"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="#1A202C"
                    app:strokeColor="#D7DEE8"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/bookings_action_cancel"
                android:textAllCaps="false"
                android:textColor="#D92C2C"
                android:textSize="14sp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#D92C2C"
                app:strokeColor="#FFD7D7"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>