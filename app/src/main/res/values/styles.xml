<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryDark">@color/primary_color</item>
        <item name="colorAccent">@color/accent_color</item>
    </style>

    <!-- Additional custom styles can be added here -->

    <style name="UberBottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_active_indicator</item>
        <item name="shapeAppearance">@style/UberBottomNavIndicatorShape</item>
        <item name="android:height">36dp</item>
        <item name="android:width">72dp</item>
    </style>

    <style name="UberBottomNavIndicatorShape" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="SkillLink.Shape.Circle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.SmoothCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
