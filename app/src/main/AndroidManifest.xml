<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.skilllink">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".SkillLinkApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_skill_link_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SkillLink"
        tools:targetApi="31">

        <!-- Firebase configuration -->
        <!-- Firebase services are automatically configured by google-services.json -->

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RoleSelectionActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".UserDashboardActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".WorkerDashboardActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".UserSignupActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".services.ServiceCategoryActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".ui.user.services.AllServicesActivity"
            android:exported="false"
            android:label="@string/all_services_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.user.account.ManageProfileActivity"
            android:exported="false"
            android:label="@string/manage_profile_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.user.account.ManagePaymentsActivity"
            android:exported="false"
            android:label="@string/manage_payments_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.payments.FakeXmlPaymentActivity"
            android:exported="false"
            android:theme="@style/Theme.SkillLink" />

        <activity
            android:name=".ui.user.account.AccountSupportActivity"
            android:exported="false"
            android:label="@string/support_center_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.worker.account.ManageServicesActivity"
            android:exported="false"
            android:label="@string/manage_services_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".WorkerDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".WorkerDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.legal.LegalDocumentActivity"
            android:exported="false"
            android:label="@string/legal_terms_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.user.home.WorkerServiceDetailActivity"
            android:exported="false"
            android:label="@string/worker_service_detail_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.user.bookings.ServiceBookingActivity"
            android:exported="false"
            android:label="@string/service_booking_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".ui.user.home.WorkerServiceDetailActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.user.home.WorkerServiceDetailActivity" />
        </activity>

        <activity
            android:name=".ui.user.chat.WorkerChatActivity"
            android:exported="false"
            android:label="@string/menu_chat"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".ui.user.home.WorkerServiceDetailActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.user.home.WorkerServiceDetailActivity" />
        </activity>

        <activity
            android:name=".ui.user.home.NearbyProfessionalsMapActivity"
            android:exported="false"
            android:label="@string/map_toolbar_title"
            android:theme="@style/Theme.SkillLink"
            android:parentActivityName=".UserDashboardActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".UserDashboardActivity" />
        </activity>

        <activity
            android:name=".ui.common.ModernNotificationsActivity"
            android:exported="false"
            android:label="@string/notifications_title"
            android:theme="@style/Theme.SkillLink" />
    </application>

</manifest>
